{
  "name": "vue-layerx",
  "version": "1.2.7",
  "description": "像路由导航一样调度弹窗，像普通组件一样复用弹窗内容",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "prepublishOnly": "run-p test:unit test:integration:all",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "pnpm test:unit",
    "test:unit": "run-p test:unit:run typecheck",
    "test:unit:run": "vitest run",
    "test:unit:watch": "vitest",
    "test:integration": "pnpm test:integration:vue3",
    "test:integration:vue2": "pnpm --filter tests-vue2 test",
    "test:integration:vue3": "pnpm --filter tests-vue3 test",
    "test:integration:all": "pnpm build && run-p test:integration:vue3 test:integration:vue2",
    "test:coverage:unit": "vitest run --coverage",
    "test:coverage:integration": "pnpm test:coverage:integration:vue3",
    "test:coverage:integration:vue2": "vitest run --config vitest.vue2-coverage.config.ts --coverage",
    "test:coverage:integration:vue3": "vitest run --config vitest.vue3-coverage.config.ts --coverage",
    "test:coverage:merge": "node scripts/merge-coverage.mjs",
    "test:coverage:all": "run-p test:coverage:unit test:coverage:integration:vue2 test:coverage:integration:vue3 && pnpm test:coverage:merge",
    "test:ci": "run-p typecheck test:integration:all test:coverage:all",
    "demos": "pnpm demos:vue3",
    "demos:vue2": "pnpm build && pnpm --filter demos-vue2 dev",
    "demos:vue3": "pnpm build && pnpm --filter demos-vue3 dev",
    "docs:stats": "node scripts/collect-test-stats.mjs",
    "docs:stats:ensure": "node scripts/collect-test-stats.mjs --placeholder",
    "docs:dev": "pnpm docs:stats:ensure && vitepress dev docs",
    "docs:build": "pnpm docs:stats:ensure && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:bundle": "node scripts/bundle-guide-md.mjs",
    "site:build": "pnpm docs:stats && pnpm docs:build && DEMOS_BASE=\"${DEMOS_VUE3_BASE:-/demos/vue3/}\" pnpm --filter demos-vue3 build && DEMOS_BASE=\"${DEMOS_VUE2_BASE:-/demos/vue2/}\" pnpm --filter demos-vue2 build && rm -rf docs/.vitepress/dist/demos && mkdir -p docs/.vitepress/dist/demos && cp -R demos-vue3/dist docs/.vitepress/dist/demos/vue3 && cp -R demos-vue2/dist docs/.vitepress/dist/demos/vue2",
    "readme:toc": "node scripts/gen-readme-toc.mjs",
    "source:bundle": "repomix --include \"src/**/*.ts\" --ignore \"**/__test__/**\" --style markdown --no-file-summary -o dist/source-bundle.md",
    "test:bundle": "node scripts/bundle-test-structure.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xuyimingwork/vue-layerx.git"
  },
  "homepage": "https://xuyimingwork.github.io/vue-layerx/",
  "bugs": {
    "url": "https://github.com/xuyimingwork/vue-layerx/issues"
  },
  "keywords": [
    "vue",
    "vue2",
    "vue3",
    "dialog",
    "modal",
    "layer",
    "composable"
  ],
  "license": "MIT",
  "peerDependencies": {
    "vue": "^2.7.0 || ^3.3.0"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "@vueuse/core": "^14.4.0",
    "element-plus": "^2.11.4",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.1.7",
    "jsdom": "^26.1.0",
    "npm-run-all2": "^9.0.4",
    "repomix": "^1.19.0",
    "shiki": "^2.5.0",
    "tsdown": "0.23.7",
    "typescript": "^5.8.3",
    "vitepress": "^1.6.3",
    "vitest": "^3.2.4",
    "vue": "^3.5.16",
    "vue-asyncx": "^1.11.3",
    "vue2": "npm:vue@^2.7.16"
  }
}
